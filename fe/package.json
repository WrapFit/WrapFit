{
  "name": "@wrapfit/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "WrapFit Frontend — 2D Canvas Editor, 3D Folding Simulation & Landing Page",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "dev:webpack": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "stitch:sync": "node scripts/stitch/sync.mjs",
    "stitch:parity": "node scripts/stitch/visual-parity.mjs",
    "shots": "node scripts/page-shots.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "tokens:check": "node scripts/check-design-tokens.mjs --max 0 && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-design-tokens.mjs --check",
    "tokens:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-design-tokens.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-query": "^5.104.1",
    "@types/animejs": "^4.0.0",
    "@wrapfit/shared": "*",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "gsap": "^3.12.5",
    "lucide-react": "^0.446.0",
    "next": "15.5.27",
    "page-mascot": "^0.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.5.2",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.8",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.168.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.10.3",
    "cheerio": "^1.2.0",
    "html-to-jsx": "^0.0.4",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "postcss-selector-parser": "^6.1.4",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.9.3"
  }
}
