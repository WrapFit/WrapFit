# WrapFit Frontend Environment Configuration
# The browser calls the API on the same origin; next.config.mjs forwards /api/* to BACKEND_INTERNAL_URL.
NEXT_PUBLIC_API_URL=/api
# Backend address seen from the Next.js server: target of the /api rewrite (read at build time) and base URL of
# server-side requests (SSR, generateMetadata).
BACKEND_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME="WrapFit Studio"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
