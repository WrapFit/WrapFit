# --- App ---
NODE_ENV=development
PORT=8080
# Danh sách origin được phép gọi API/WebSocket, ngăn cách bằng dấu phẩy.
# Phải là origin cụ thể (không dùng "*") thì trình duyệt mới gửi cookie đăng nhập khi FE gọi thẳng cổng 8080.
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
# "true" khi API đứng sau proxy (Caddy, hoặc rewrite /api của Next.js khi chạy local): giới hạn tần suất và số lần
# đăng nhập sai tính theo IP thật của người dùng thay vì IP của proxy. Không bật khi API mở thẳng ra Internet.
TRUST_PROXY=false

# --- Database (PostgreSQL) ---
# Khớp với service `postgres` trong docker-compose.yml ở gốc repo (chạy: docker compose up -d postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/wrapfit?schema=public"

# --- Auth ---
# BẮT BUỘC đổi hai secret này (tối thiểu 32 ký tự). Tạo nhanh: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Link một lần trong email (xác minh, đặt mật khẩu). Để trống = dùng JWT_REFRESH_SECRET. Production: đặt riêng (>= 32 ký tự)
AUTH_TOKEN_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=10
# Token nằm trong cookie HttpOnly. Để trống = tự động (bật Secure khi NODE_ENV=production).
COOKIE_SECURE=
# Trang frontend mà trình duyệt quay về sau khi đăng nhập Google
FRONTEND_URL=http://localhost:3000

# --- Google OAuth 2.0 (để trống cả hai = tắt "Đăng nhập bằng Google"; xem be/README.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phải khai báo đúng URL này trong "Authorized redirect URIs" của OAuth client trên Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# --- Hàng đợi BullMQ (IT3-11): docker compose up -d redis; worker chạy bằng `npm run dev:worker` ---
REDIS_URL=redis://localhost:6379
EXPORT_CONCURRENCY=2

# --- Email (worker): xác minh email, đặt lại mật khẩu. Mặc định = Mailpit local, xem thư tại http://localhost:8025 ---
# Production: Resend (docs/10_DB_HARDENING_DESIGN.md, mục 7), domain gửi mail.wrapfit.vn đã cấu hình SPF + DKIM + DMARC:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=resend  SMTP_PASS=<Resend API key>
#   MAIL_FROM=WrapFit <no-reply@mail.wrapfit.vn>
# Kiểm tra: npm --workspace=be run mail:test -- you@example.com (gửi 1 thư thử bằng cấu hình hiện tại)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WrapFit <no-reply@wrapfit.local>

# --- Log: json = mỗi dòng một object JSON (kèm requestId), text = dễ đọc. Để trống = json khi NODE_ENV=production ---
LOG_FORMAT=

# --- AI sinh hoa văn (IT3-09). Để trống ANTHROPIC_API_KEY = chỉ dùng hoa văn sinh bằng thuật toán ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=30000

# --- Rate limit (mặc định cho toàn bộ API) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- Seed (`npm run db:seed`; production chỉ tạo admin khi đặt SEED_ADMIN_PASSWORD) ---
SEED_ADMIN_EMAIL=admin@wrapfit.vn
SEED_ADMIN_PASSWORD=Admin@12345

# --- Lưu trữ file S3 / Cloudflare R2 (IT3-08). Để trống STORAGE_BUCKET = tắt upload (API trả 503) ---
# Mặc định: SeaweedFS chạy local (docker compose up -d seaweedfs storage-init), khóa dev trong docker/seaweedfs/s3.json
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=wrapfit
# File xuất in: bucket không có URL công khai (trống = dùng STORAGE_BUCKET, ai biết key cũng tải được)
STORAGE_PRIVATE_BUCKET=wrapfit-private
STORAGE_ACCESS_KEY_ID=wrapfit-dev-access
STORAGE_SECRET_ACCESS_KEY=wrapfit-dev-secret-change-me
STORAGE_PUBLIC_URL=http://localhost:8333/wrapfit
STORAGE_FORCE_PATH_STYLE=true
# Cloudflare R2 (production):
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=wrapfit
# STORAGE_PRIVATE_BUCKET=wrapfit-private
# STORAGE_ACCESS_KEY_ID=<R2 API token: Access Key ID>
# STORAGE_SECRET_ACCESS_KEY=<R2 API token: Secret Access Key>
# STORAGE_PUBLIC_URL=https://cdn.wrapfit.vn
# STORAGE_FORCE_PATH_STYLE=false
# Bucket R2 chứa bản dump DB đã mã hóa (pg_dump | age). API không ghi vào đây; trống = không có
STORAGE_BACKUP_BUCKET=
# STORAGE_BACKUP_BUCKET=wrapfit-backups

# --- Cloudinary: CDN ảnh công khai (avatar, logo, texture AI, thumbnail). Chưa nối dữ liệu, chỉ cấu hình kết nối ---
# Đặt cả ba hoặc để trống cả ba (= tắt). Dashboard → Settings → API Keys. Kiểm tra: npm --workspace=be run storage:check
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thư mục gốc của môi trường này trên Cloudinary (tách dev và production)
CLOUDINARY_FOLDER=wrapfit-dev
