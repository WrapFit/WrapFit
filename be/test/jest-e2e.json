{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "isolatedModules": true
        }
      }
    ]
  },
  "maxWorkers": 1,
  "workerIdleMemoryLimit": "1GB",
  "setupFiles": [
    "<rootDir>/e2e-env.ts"
  ]
}
