{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // dist/app.js, dist/worker.js (Dockerfile, docker-entrypoint.sh, npm start:*): a file outside src/ fails the build
    // instead of silently moving the output to dist/src/.
    "rootDir": "./src",
    // Inside dist/: `nest build` deletes dist first (deleteOutDir), and a leftover cache would make tsc emit nothing.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "dist-worker", "prisma", "**/*spec.ts"]
}
