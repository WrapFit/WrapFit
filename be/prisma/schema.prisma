// WrapFit — Schema v2.1 (xem tài liệu 07, Mục 4.1).
// Khóa chính UUIDv7 (tăng dần theo thời gian: index B-tree không bị phân mảnh), trừ refresh_tokens.id = jti do code sinh.
// Chỉ truy cập qua PrismaService (src/shared/prisma/prisma.service.ts). Tên bảng/cột dạng snake_case.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MAKER // Khách hàng cá nhân tự làm hộp quà
  PRO_ARTISAN // Chủ shop handmade bán quà chuyên nghiệp
  PRINT_SHOP // Đối tác xưởng in nhận đơn bế
  ADMIN // Quản trị viên hệ thống
}

enum SubscriptionTier {
  FREE
  PAY_PER_EXPORT
  STARTER
  PRO_BUSINESS
}

enum ProjectStatus {
  ACTIVE // Đang thiết kế / sử dụng
  ARCHIVED // Đã lưu trữ vào kho cũ
  DELETED // Đang nằm trong thùng rác (xóa vĩnh viễn sau 30 ngày)
}

enum ProjectVisibility {
  PRIVATE // Chỉ chủ sở hữu xem được
  UNLISTED // Ai có link bí mật đều xem được
  PUBLIC // Hiển thị công khai trên Thư viện Cộng đồng
}

// Bộ lọc Thư viện mẫu (UC-12). FE hiển thị nhãn tiếng Việt.
enum Occasion {
  TET // Tết Nguyên Đán
  CHRISTMAS // Giáng Sinh
  WEDDING // Cưới / Đính hôn
  VALENTINE // Lễ Tình Nhân
  BIRTHDAY // Sinh nhật
  MINIMAL // Tối giản thường ngày
}

enum Industry {
  COSMETICS // Mỹ phẩm & Skincare
  CANDLES // Nến thơm & Tinh dầu
  BAKERY // Bánh ngọt & Bếp thủ công
  JEWELRY // Trang sức & Phụ kiện
  TEA_AGRI // Trà hoa & Nông sản cao cấp
}

// Mục đích của file người dùng tải lên (IT3-08): quyết định định dạng và dung lượng tối đa được phép.
enum FilePurpose {
  LOGO // Logo / ảnh vector cho canvas (PNG, JPEG, WebP, SVG, PDF; tối đa 15 MB)
  IMAGE // Ảnh đặt lên mặt hộp (PNG, JPEG, WebP; tối đa 15 MB)
  THUMBNAIL // Ảnh xem trước dự án / mốc phiên bản (PNG, JPEG, WebP; tối đa 2 MB)
  AVATAR // Ảnh đại diện (PNG, JPEG, WebP; tối đa 2 MB)
  QR_CODE // Mã QR mở hộp do backend sinh (PNG + SVG), người dùng không upload được
  EXPORT // File in (PDF / SVG / DXF) do worker xuất (IT3-11)
}

// Mục đích của mã một lần gửi qua email (auth_tokens).
enum AuthTokenPurpose {
  VERIFY_EMAIL // Xác minh email sau khi đăng ký: chưa xác minh thì không đăng nhập được
  RESET_PASSWORD // Đặt lại mật khẩu (quên mật khẩu)
  COMPLETE_SIGNUP // Đăng ký lại một email chưa xác minh: chủ hộp thư đặt mật khẩu của mình (giống RESET_PASSWORD)
}

enum ExportStatus {
  PENDING // Đã vào hàng đợi BullMQ
  PROCESSING // Worker đang xử lý
  COMPLETED // Đã tải lên S3/R2
  FAILED // Lỗi, xem errorLog
}

enum ExportFileType {
  PDF_CMYK // PDF tách lớp CMYK 300 DPI
  PDF_A4_PRINT // PDF A4/A3 có dấu xén (crop marks) để tự in tại nhà / văn phòng (Luồng của Linh)
  SVG // SVG cho máy cắt Cricut / Laser
  DXF // DXF cho máy bế CNC
  PRINT_PACKAGE // ZIP bàn giao nhà in: file gốc .ai (tương thích PDF) + PDF in + JPG đối chiếu + SVG/DXF + phiếu kiểm tra
}

model User {
  id               String           @id @default(uuid(7)) @db.Uuid
  email            String           @unique
  passwordHash     String?          @map("password_hash") // null nếu chỉ đăng nhập bằng Google
  googleId         String?          @unique @map("google_id")
  // Thời điểm chứng minh sở hữu email (link xác minh, đặt lại mật khẩu hoặc Google). null = chưa đăng nhập được.
  emailVerifiedAt  DateTime?        @map("email_verified_at") @db.Timestamptz(3)
  fullName         String?          @map("full_name")
  avatarUrl        String?          @map("avatar_url") // Ảnh từ nguồn ngoài (Google); ảnh tải lên WrapFit nằm ở avatarKey
  avatarKey        String?          @map("avatar_key") // Key trên bucket; API trả avatarUrl = URL của key, ưu tiên hơn avatarUrl
  shopName         String?          @map("shop_name")
  role             Role             @default(MAKER)
  subscriptionTier SubscriptionTier @default(FREE) @map("subscription_tier")
  brandKit         Json?            @map("brand_kit") // { logoKey, colors, fonts, slogan } (API trả logoUrl)
  referralCode     String?          @unique @map("referral_code")
  referredById     String?          @map("referred_by_id") @db.Uuid
  isActive         Boolean          @default(true) @map("is_active") // Admin khóa tài khoản
  // Tăng mỗi lần đăng xuất mọi thiết bị (đặt lại mật khẩu, logout-all, khóa tài khoản…). Access / refresh token mang
  // số này (claim `sv`): token mang số cũ bị từ chối ngay, không chờ hết hạn.
  sessionVersion   Int              @default(0) @map("session_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  referredBy    User?               @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]              @relation("UserReferrals")
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]
  projects      PackagingProject[]
  collections   ProjectCollection[]
  mockups       SocialMockup[]
  projectLikes  ProjectLike[]
  storedFiles   StoredFile[]
  aiGenerations AiGeneration[]
  payments      Payment[]
  creditLots    CreditLot[]
  exportUnlocks ExportUnlock[]
  subscriptions Subscription[]

  @@index([referredById])
  @@map("users")
}

// Mỗi refresh token là một dòng; `id` chính là `jti` trong JWT -> hỗ trợ nhiều thiết bị, xoay vòng và thu hồi.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  // Token mới thay thế khi /auth/refresh xoay vòng (logout thì để null): dùng lại token ngay sau đó là một tab khác
  // refresh cùng lúc, không phải token bị đánh cắp.
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // AuthMaintenanceTask xóa token hết hạn
  @@map("refresh_tokens")
}

// Mã một lần gửi qua email (xác minh email, đặt lại mật khẩu). Chỉ lưu SHA-256 của mã: lộ DB không lộ link.
// Mỗi người dùng có tối đa một mã còn hiệu lực cho mỗi mục đích (unique index một phần, chỉ có trong migration).
model AuthToken {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(3) // Đã dùng, hoặc bị thay bằng mã mới hơn
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt]) // Giới hạn số lần gửi lại
  @@index([expiresAt]) // AuthMaintenanceTask xóa mã hết hạn
  @@map("auth_tokens")
}

model ProjectCollection {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  description String?
  colorTag    String?  @default("#D4A373") @map("color_tag")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects PackagingProject[]

  @@index([userId])
  @@map("project_collections")
}

model BoxTemplate {
  id             String  @id // tuck-top, sleeve-drawer, lid-base, pillow
  name           String
  category       String  @default("retail") // retail, luxury, food, accessories
  description    String?
  formulaSchema  Json    @map("formula_schema")
  // Phiên bản công thức dieline (@wrapfit/shared, parametric/registry.ts) gán cho dự án mới của cấu trúc này
  formulaVersion Int     @default(1) @map("formula_version")
  preview3dUrl   String? @map("preview_3d_url")
  isCurated      Boolean @default(true) @map("is_curated")
  isActive       Boolean @default(true) @map("is_active")

  projects        PackagingProject[]
  designTemplates DesignTemplate[]

  @@map("box_templates")
}

// Mẫu thiết kế "WrapFit Curated" trong Thư viện mẫu (UC-12, UC-13): cấu trúc hộp + kích thước + đồ họa dựng sẵn.
// Mẫu cộng đồng không nằm ở đây: đó là các PackagingProject PUBLIC.
model DesignTemplate {
  id            String    @id @default(uuid(7)) @db.Uuid
  boxTemplateId String    @map("box_template_id")
  title         String
  description   String?
  occasion      Occasion?
  industry      Industry?
  dimensions    Json // { length, width, height, paperThickness }
  materialSpec  Json      @map("material_spec") // { type, gsm, caliper, finish }
  canvasState   Json      @map("canvas_state") // { elements: [...] }
  thumbnailUrl  String?   @map("thumbnail_url")
  tags          String[]  @default([])
  usesCount     Int       @default(0) @map("uses_count") // Số lần "Dùng mẫu này"
  sortOrder     Int       @default(0) @map("sort_order") // Nhỏ hơn = hiển thị trước
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  boxTemplate BoxTemplate @relation(fields: [boxTemplateId], references: [id])

  @@index([isActive, sortOrder])
  @@index([boxTemplateId])
  @@map("design_templates")
}

model PackagingProject {
  id             String            @id @default(uuid(7)) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  templateId     String            @map("template_id")
  collectionId   String?           @map("collection_id") @db.Uuid
  title          String
  slug           String            @unique @default(nanoid(10)) // Link công khai /p/[slug]
  status         ProjectStatus     @default(ACTIVE)
  visibility     ProjectVisibility @default(PRIVATE)
  allowFork      Boolean           @default(true) @map("allow_fork")
  forkedFromId   String?           @map("forked_from_id") @db.Uuid
  dimensions     Json // { length, width, height, paperThickness }
  materialSpec   Json              @map("material_spec") // { type, gsm, caliper, finish }
  canvasState    Json              @map("canvas_state") // { elements: [...] }; ảnh tải lên lưu bằng key (users/...), API trả URL
  fitcheckState  Json?             @map("fitcheck_state") // { isValid, score, violations }
  fitcheckScore  Int?              @map("fitcheck_score") // = fitcheckState.score: thẻ Dashboard (UC-03), kiểm duyệt Thư viện ≥ 90 (UC-14)
  thumbnailKey   String?           @map("thumbnail_key") // Key trên bucket; API trả thumbnailUrl
  tags           String[]          @default([])
  occasion       Occasion? // Gắn khi chia sẻ lên Thư viện cộng đồng (bộ lọc UC-12)
  industry       Industry?
  viewsCount     Int               @default(0) @map("views_count")
  likesCount     Int               @default(0) @map("likes_count")
  version        Int               @default(1) // +1 mỗi lần nội dung thay đổi: chặn lưu đè giữa hai tab (409)
  // Chốt lúc tạo dự án (= boxTemplate.formulaVersion): sửa công thức không làm xê dịch dieline cũ. Chỉ đổi khi chủ dự án
  // bấm cập nhật công thức hoặc script db:upgrade-formulas (docs/12 Phase 8, 8.10), luôn kèm một mốc để hoàn tác
  formulaVersion Int               @map("formula_version")
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(3) // Thời điểm vào thùng rác
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  template       BoxTemplate         @relation(fields: [templateId], references: [id])
  collection     ProjectCollection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  forkedFrom     PackagingProject?   @relation("ProjectForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks          PackagingProject[]  @relation("ProjectForks")
  exportJobs     ExportJob[]
  unboxingConfig UnboxingExperience?
  socialMockups  SocialMockup[]
  snapshots      ProjectSnapshot[]
  likes          ProjectLike[]
  files          StoredFile[]
  fileRefs       ProjectFileRef[]
  exportUnlocks  ExportUnlock[]

  @@index([userId, status]) // Dashboard: lọc dự án theo trạng thái
  @@index([visibility, status, likesCount]) // Thư viện cộng đồng: dự án PUBLIC, nhiều tim nhất trước
  @@index([status, deletedAt]) // Cron dọn thùng rác
  @@index([collectionId])
  @@index([templateId])
  @@index([forkedFromId]) // Đếm lượt remix trên thẻ Thư viện; SET NULL khi xóa bản gốc
  @@map("packaging_projects")
}

model ProjectSnapshot {
  id             String   @id @default(uuid(7)) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  name           String // "Trước khi đổi màu hoa văn", "Bản xuất in lần 1"
  canvasState    Json     @map("canvas_state")
  dimensions     Json
  previewKey     String?  @map("preview_key") // Key trên bucket; API trả previewUrl
  isAutomatic    Boolean  @default(false) @map("is_automatic") // Mốc tự động (xuất in, sao lưu trước khi khôi phục): không tính vào giới hạn 50 mốc thủ công
  // Phiên bản công thức dieline của dự án lúc lưu mốc; khôi phục mốc thì đặt lại phiên bản đó (hoàn tác cập nhật công
  // thức). null: mốc lưu trước khi có cột này, khôi phục giữ phiên bản hiện tại.
  formulaVersion Int?     @map("formula_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project PackagingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_snapshots")
}

model ProjectLike {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project PackagingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_likes")
}

model UnboxingExperience {
  id             String   @id @default(uuid(7)) @db.Uuid
  projectId      String   @unique @map("project_id") @db.Uuid
  slug           String   @unique @default(nanoid(12))
  recipientName  String   @map("recipient_name")
  giftNote       String   @map("gift_note") @db.Text
  audioTrackUrl  String?  @map("audio_track_url")
  particleEffect String   @default("confetti") @map("particle_effect")
  viewsCount     Int      @default(0) @map("views_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project PackagingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("unboxing_experiences")
}

model SocialMockup {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  presetName String   @map("preset_name")
  renderKey  String   @map("render_key") // Key trên bucket của ảnh render
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project PackagingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@map("social_mockups")
}

model ExportJob {
  id          String         @id @default(uuid(7)) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  fileType    ExportFileType @map("file_type")
  status      ExportStatus   @default(PENDING)
  storageKey  String?        @map("storage_key") // Key trên S3/R2; link tải là pre-signed URL sinh lúc request
  errorLog    String?        @map("error_log")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime?      @map("completed_at") @db.Timestamptz(3)
  watermarked Boolean        @default(false) // PDF A4 miễn phí: in dòng "Thiết kế bằng WrapFit" ở tai dán
  unlockId    String?        @map("unlock_id") @db.Uuid // Lượt xuất đã trả cho job này: hoàn lượt khi job lỗi

  project PackagingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unlock  ExportUnlock?    @relation(fields: [unlockId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([unlockId])
  @@map("export_jobs")
}

// File trên S3 / R2 (IT3-08). Ghi lại lúc cấp pre-signed URL: chữ ký khóa đúng dung lượng và định dạng,
// nên `size` dùng được để tính hạn mức theo gói. File gắn với dự án bị xóa khỏi bucket khi dự án bị xóa vĩnh viễn.
model StoredFile {
  id          String      @id @default(uuid(7)) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  projectId   String?     @map("project_id") @db.Uuid
  key         String      @unique // users/<userId>/<purpose>/<uuid>.<ext>
  purpose     FilePurpose
  contentType String      @map("content_type")
  size        Int // byte
  // Thời điểm xác nhận file có thật trên bucket. null = mới cấp URL, chưa biết trình duyệt đã upload chưa:
  // StorageMaintenanceTask kiểm tra (HEAD) rồi xác nhận hoặc xóa dòng.
  confirmedAt DateTime?   @map("confirmed_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project PackagingProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  refs    ProjectFileRef[]
  library LibraryAsset?

  @@index([userId])
  @@index([projectId])
  @@index([confirmedAt, createdAt])
  @@map("stored_files")
}

// Ảnh tải lên mà một dự án đang hiển thị (canvas của dự án hoặc của các mốc phiên bản). Bản remix hiển thị ảnh của
// tác giả gốc: file chỉ được xóa khỏi bucket khi không còn dự án nào trỏ tới. Đồng bộ trong cùng transaction với mỗi lần
// ghi canvas (projects/infrastructure/project-file-refs.ts). Xóa file còn được tham chiếu bị khóa ngoại chặn lại.
model ProjectFileRef {
  projectId    String @map("project_id") @db.Uuid
  storedFileId String @map("stored_file_id") @db.Uuid

  project    PackagingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storedFile StoredFile       @relation(fields: [storedFileId], references: [id], onDelete: NoAction)

  @@id([projectId, storedFileId])
  @@index([storedFileId])
  @@map("project_file_refs")
}

// Object trên bucket không xóa được (lỗi S3) sau khi dòng DB đã bị xóa: StorageMaintenanceTask thử xóa lại.
// Loại tài nguyên trong thư viện do admin nhập.
enum LibraryAssetCategory {
  STICKER // Tem, sticker
  LABEL // Nhãn, khung nhãn
  ILLUSTRATION // Hình minh họa
  BACKGROUND // Nền, hoa văn
  ICON // Biểu tượng
}

// Tài nguyên thư viện admin nhập từ nguồn có giấy phép rõ ràng (CC0, OFL, MIT, tự vẽ...), dùng chung cho mọi người
// dùng. File là một upload của admin (purpose LOGO / IMAGE): dòng này giữ file không bị dọn như upload bỏ quên và cho
// phép canvas của người khác hiển thị nó. Mỗi file được kiểm tra khi nhập: SVG không có script hay liên kết ra ngoài,
// ảnh raster đủ điểm ảnh để in 300 DPI ở `maxPrintMm`.
model LibraryAsset {
  id           String               @id @default(uuid(7)) @db.Uuid
  category     LibraryAssetCategory
  title        String
  storedFileId String               @unique @map("stored_file_id") @db.Uuid
  fileKey      String               @map("file_key")
  contentType  String               @map("content_type")
  isVector     Boolean              @default(false) @map("is_vector")
  widthPx      Int?                 @map("width_px")
  heightPx     Int?                 @map("height_px")
  // Cạnh dài nhất in được ở 300 DPI (mm); null với file vector
  maxPrintMm   Float?               @map("max_print_mm")
  license      String // Mã giấy phép: CC0-1.0, OFL-1.1, MIT, CC-BY-4.0, OWN-WORK...
  sourceUrl    String?              @map("source_url")
  attribution  String? // Bắt buộc với giấy phép yêu cầu ghi nguồn (CC-BY)
  tags         String[]             @default([])
  occasions    Occasion[]           @default([])
  isActive     Boolean              @default(true) @map("is_active")
  createdById  String               @map("created_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)

  @@index([isActive, category])
  @@map("library_assets")
}

model OrphanedObject {
  key       String   @id
  attempts  Int      @default(0)
  lastError String?  @map("last_error")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("orphaned_objects")
}

// Mỗi lần gọi AI sinh hoa văn (IT3-09): dùng để giới hạn số lượt theo gói và theo dõi chi phí token.
// Lần sinh bằng thuật toán dự phòng (không gọi AI) không được ghi.
model AiGeneration {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  theme        String
  model        String // vd. claude-opus-5-5 (model thực sự trả lời, kể cả khi fallback)
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_generations")
}

// ============================================================================
// Billing core (docs/16 §6, trimmed by docs/17 S1). Money is an Int in VND. Export credits are a ledger: lots with an
// expiry (`credit_lots`) spent by debit rows (`credit_debits`); `users.subscription_tier` is only a cache written by
// PlanService.sync. CHECK constraints live in migration 20261030000100_billing_core.
// ============================================================================

enum PaymentPurpose {
  EXPORT_1 // 1 lượt xuất, 19.000đ
  EXPORT_5 // 5 lượt xuất, 79.000đ
  EXPORT_15 // 15 lượt xuất, 199.000đ
  PRO_MONTH // Pro 30 ngày, 99.000đ
  SAMPLE_ORDER // Đơn in mẫu (số tiền theo đơn)
}

enum PaymentStatus {
  PENDING // Chờ chuyển khoản, hết hạn sau 15 phút
  PAID
  EXPIRED
  CANCELLED
}

enum CreditKind {
  EXPORT // Lượt xuất file sạch (credit AI theo lô chưa làm: docs/17 M2)
}

enum CreditSource {
  PURCHASE // Mua gói lượt: tính là gói Lượt xuất khi còn hạn
  ADMIN // Admin cấp tay (tài khoản demo, bồi thường): không đổi gói
}

enum CreditDebitReason {
  EXPORT_UNLOCK // Mở khóa một bản thiết kế (project, version)
  ADMIN_ADJUSTMENT
}

enum SubscriptionStatus {
  ACTIVE // Trong chu kỳ đã trả
  EXPIRED // Hết chu kỳ (không gia hạn tự động: docs/17 M4)
}

// One payment request (VietQR transfer, simulated in the CP4 demo). `reference` is the transfer content.
model Payment {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  purpose   PaymentPurpose
  amountVnd Int            @map("amount_vnd")
  reference String         @unique // "WF" + 6 ký tự [A-Z0-9] (CHECK), khớp nội dung chuyển khoản
  status    PaymentStatus  @default(PENDING)
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  paidAt    DateTime?      @map("paid_at") @db.Timestamptz(3)
  metadata  Json? // Chụp lại lúc tạo: { credits } | { periodDays } | { orderId }
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditLots    CreditLot[]
  subscriptions Subscription[]

  @@index([userId, createdAt])
  @@index([status, expiresAt]) // Đánh dấu EXPIRED
  @@map("payments")
}

// A batch of credits with an expiry. Balance = sum of `remaining` over the lots not expired.
model CreditLot {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  kind      CreditKind
  source    CreditSource
  quantity  Int // Số lượt cấp
  remaining Int // Còn lại: chỉ CreditsService sửa, trong transaction có khóa dòng
  expiresAt DateTime?    @map("expires_at") @db.Timestamptz(3) // null = không hết hạn (chỉ lô ADMIN)
  paymentId String?      @map("payment_id") @db.Uuid
  note      String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  debits  CreditDebit[]

  @@index([userId, kind, expiresAt])
  @@index([paymentId])
  @@map("credit_lots")
}

// One debit may take from several lots: the rows of one operation share `operationId`.
model CreditDebit {
  id          String            @id @default(uuid(7)) @db.Uuid
  operationId String            @map("operation_id") @db.Uuid
  lotId       String            @map("lot_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  quantity    Int
  reason      CreditDebitReason
  refId       String?           @map("ref_id") // vd. export_unlocks.id
  refundedAt  DateTime?         @map("refunded_at") @db.Timestamptz(3) // Hoàn đúng một lần
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  lot CreditLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([operationId, lotId])
  @@index([lotId])
  @@index([userId, createdAt])
  @@map("credit_debits")
}

// One credit unlocks every clean format of one design version (project, version) for `export.unlockDays` days.
model ExportUnlock {
  id               String    @id @default(uuid(7)) @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  projectVersion   Int       @map("project_version")
  userId           String    @map("user_id") @db.Uuid // Người trả lượt
  debitOperationId String    @map("debit_operation_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  refundedAt       DateTime? @map("refunded_at") @db.Timestamptz(3) // Xuất lỗi, đã hoàn lượt
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  project    PackagingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exportJobs ExportJob[]

  @@index([projectId, projectVersion])
  @@index([userId])
  @@index([debitOperationId])
  @@map("export_unlocks")
}

// A paid plan period. At most one ACTIVE row per user (partial unique index in the migration).
model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  plan               SubscriptionTier // Chỉ STARTER | PRO_BUSINESS (CHECK)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(3)
  paymentId          String?            @map("payment_id") @db.Uuid // Thanh toán gần nhất (tạo / gia hạn)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([paymentId])
  @@map("subscriptions")
}
