# ===================================================
# WrapFit Full-Stack Docker Environment Configuration
# Copy to `.env` (repo root) before running `docker compose up`.
# ===================================================

# Production (docker-compose.prod.yml + Caddy HTTPS): your domain and the Let's Encrypt contact
APP_DOMAIN=
ACME_EMAIL=

# Application Ports
# Backend uses 8080: 3000 belongs to Next.js, and ranges around 4000/5000 are often reserved by Hyper-V/WSL on Windows.
FRONTEND_PORT=3000
PORT=8080
POSTGRES_PORT=5432

# PostgreSQL Database. "password" is for local development only: production (docker-compose.prod.yml) needs your own
# URL-safe value (openssl rand -hex 32), set BEFORE the first start (see be/README.md to change it later).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=wrapfit

# Redis password, required in production (URL-safe: openssl rand -hex 32). Local development runs Redis without one.
REDIS_PASSWORD=

# Backend Auth — REQUIRED, at least 32 characters, two different values.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Backend misc
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 — leave both empty to disable "Sign in with Google" (setup guide: be/README.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# Object storage (S3-compatible). Defaults in docker-compose.yml use the local SeaweedFS container.
# Cloudflare R2 (production): see be/README.md, section "Lưu trữ file".
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_PUBLIC_ENDPOINT=
# STORAGE_REGION=auto
# STORAGE_BUCKET=wrapfit
# STORAGE_PRIVATE_BUCKET=wrapfit-private
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL=https://cdn.wrapfit.vn
# STORAGE_FORCE_PATH_STYLE=false
# Encrypted database dumps (no public URL), written by the backup job, never by the API
# STORAGE_BACKUP_BUCKET=wrapfit-backups
STORAGE_PORT=8333

# Cloudinary: public image CDN. Set the three together or leave them all empty (disabled).
# Only the connection for now: `docker compose exec backend node dist/storage-check.js` tests it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wrapfit
REDIS_PORT=6379
# Export jobs rendered in parallel by one worker
EXPORT_CONCURRENCY=2

# AI pattern generator (Claude API). Empty = built-in procedural patterns only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Optional: create an admin account on start (leave empty to skip in production)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Frontend: the browser calls the API on its own origin (/api). Next.js forwards /api/* to the backend (the
# `frontend` service sets BACKEND_INTERNAL_URL=http://backend:8080), Caddy does it in production.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME="WrapFit Studio"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
